# ---------------------------------------------------------------------------
# Copie para .env:   cp .env.example .env
# .env NUNCA é commitado (requisito 41).
# ---------------------------------------------------------------------------

# --- ambiente --------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false

# Dado mock. A aplicação se recusa a subir com true em production.
USE_MOCK_DATA=false

# --- banco -----------------------------------------------------------------
POSTGRES_USER=albion
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=albion
POSTGRES_PORT=5432
# Usada quando se roda o backend fora do compose. Dentro do compose o
# docker-compose.yml sobrescreve com o host "postgres".
DATABASE_URL=postgresql+asyncpg://albion:troque-esta-senha@localhost:5432/albion
# Banco usado pelos testes de integração. Eles criam e derrubam o schema, então
# NUNCA aponte para o banco de trabalho.
TEST_DATABASE_URL=postgresql+asyncpg://albion:troque-esta-senha@localhost:5432/albion_test

# --- cache -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- portas ----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- AODP ------------------------------------------------------------------
# Hosts verificados em 2026-09-12 (docs/02-aodp.md). Não precisam ser alterados.
AODP_DEFAULT_SERVER=west
AODP_TIMEOUT_SECONDS=15
# O projeto AODP é comunitário e pede identificação de quem consome em volume.
# Coloque um contato real antes de rodar collector em produção.
AODP_USER_AGENT=AlbionEconomyIntelligence/0.1 (+seu-email-ou-discord)
AODP_RATE_LIMIT_PER_MINUTE=180
AODP_RATE_LIMIT_PER_5_MINUTES=300

# --- collector -------------------------------------------------------------
COLLECTOR_SERVER=west
COLLECTOR_INTERVAL_SECONDS=900

# --- frescor do dado -------------------------------------------------------
FRESHNESS_FRESH_SECONDS=900      # até 15 min  -> ATUALIZADO
FRESHNESS_STALE_SECONDS=21600    # até 6 h     -> DESATUALIZADO; acima -> ANTIGO
